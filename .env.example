# Copy this file to .env (cp .env.example .env). The .env file is never committed.
# These values are for local development only: never reuse them in any other environment.
POSTGRES_USER=shortener
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=shortener
POSTGRES_PORT=5432

# Application settings, read by the Go application (see internal/config).
# The Makefile loads .env (a copy of this file), so write NAME=value with no quotes and no spaces
# around "=" (the one syntax that Make and Compose read the same way).
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# PostgreSQL connection URL used by the application. It is a SECRET (it has the
# password). User, password, database and port must match the POSTGRES_* values
# above. sslmode=disable only because the local database listens on 127.0.0.1.
# Special characters in the password must be percent-encoded (e.g. @ as %40, # as %23).
DATABASE_URL=postgres://shortener:local-dev-only-change-me@127.0.0.1:5432/shortener?sslmode=disable
